# Copy to `.env` for local development. Do not create `.env.local`.
# Never commit real secrets. Production values live on the VPS, not in Git.

# -----------------------------------------------------------------------------
# Build-time
# -----------------------------------------------------------------------------
# This app has no NEXT_PUBLIC_* variables. Docker build / `next build` do not
# need secrets. Do not pass AUTH_SECRET, MONGODB_URI, or Cloudinary keys as
# Docker build args — they are injected at container runtime from `.env`.

# -----------------------------------------------------------------------------
# Runtime — Docker Compose on the VPS
# -----------------------------------------------------------------------------
# Traefik Host() rule (hostname only, no scheme).
SITE_HOST=example.com

# Set by GitHub Actions on each deploy. Do not set locally.
PORTFOLIO_IMAGE=ghcr.io/OWNER/REPOSITORY:IMAGE_TAG

# -----------------------------------------------------------------------------
# Runtime — application
# -----------------------------------------------------------------------------
# Docker / production Compose set NODE_ENV=production.
# Do not set NODE_ENV=production in a local `.env` used with `next dev`.
PORT=3000
HOSTNAME=0.0.0.0

# AUTH_URL is the public origin Auth.js uses for callbacks.
# Local: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=

# Optional — GitHub contribution graph (public calendar works without this;
# a PAT avoids rate limits: https://github.com/settings/tokens)
GITHUB_TOKEN=

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Images — paste the full CLOUDINARY_URL from the Cloudinary console, or the three fields.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — Gemini (Google AI Studio). Used for project drafts, field rewrites,
# and admin job-application resumes / cover letters / screening answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — Google Analytics 4. Measurement IDs appear in page source (not a secret),
# but do not commit yours: set this only in the VPS `.env`. Leave empty to keep GA off.
GA_MEASUREMENT_ID=

# Optional — Gmail SMTP visit summaries (use an App Password, not your login password)
NOTIFY_EMAIL=
NOTIFY_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional — Gmail API for sending and syncing job-application mail.
# Enable Gmail API in Google Cloud, create an OAuth client, then store a refresh
# token. Sending needs gmail.send. Inbox sync needs gmail.readonly as well
# (re-consent with both scopes, then replace GMAIL_REFRESH_TOKEN).
# SMTP_USER/SMTP_PASS is used to send if the API is unset. SMTP cannot sync replies.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Optional — Gmail inbox sync. Push endpoint (Pub/Sub) must include this token:
# https://YOUR_DOMAIN/api/internal/gmail-push?token=...
# Poll backup: POST /api/internal/gmail-sync with Authorization: Bearer ...
# Grant gmail-api-push@system.gserviceaccount.com publisher on the topic.
# Watch expires ~7 days; production renews it on the 15-minute loop.
GMAIL_SYNC_SECRET=
GMAIL_PUBSUB_TOPIC=
# Set to 1 to run the loop in `next dev`. Set to 0 to disable it in production.
# GMAIL_SYNC_LOOP=
