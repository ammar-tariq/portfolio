# Copy to `.env` for local development. Do not create `.env.local`.
# Never commit real secrets. Production values live on the VPS, not in Git.
#
# This app has no NEXT_PUBLIC_* variables. `next build` / Docker image build
# do not need secrets. Do not pass AUTH_SECRET, MONGODB_URI, or Cloudinary
# keys as Docker build args — they are injected at container runtime from `.env`.

# -----------------------------------------------------------------------------
# VPS / Docker only (skip locally)
# -----------------------------------------------------------------------------
# Traefik Host() rule (hostname only, no scheme).
SITE_HOST=ammartariq.com
# Set by GitHub Actions on each deploy. Do not set locally.
PORTFOLIO_IMAGE=ghcr.io/OWNER/REPOSITORY:IMAGE_TAG
# Compose sets NODE_ENV=production. Do not set that in a local `.env`.
PORT=3000
HOSTNAME=0.0.0.0

# -----------------------------------------------------------------------------
# Site / Auth.js
# -----------------------------------------------------------------------------
# AUTH_URL is the public origin Auth.js uses for callbacks.
# Local: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_SECRET=

# GitHub OAuth app + the login allowed into /admin.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=

# -----------------------------------------------------------------------------
# GitHub API
# -----------------------------------------------------------------------------
# Contribution graph works without this; a PAT avoids rate limits.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
MONGODB_URI=

# -----------------------------------------------------------------------------
# Images (Cloudinary)
# -----------------------------------------------------------------------------
# Paste the full CLOUDINARY_URL from the Cloudinary console, or the three fields.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Gemini (Google AI Studio)
# -----------------------------------------------------------------------------
# Project drafts, field rewrites, and job-application generate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# Container / measurement IDs appear in page source (not secrets), but do not
# commit yours. One Google tag per page: if GA_MEASUREMENT_ID is set, GTM is
# not injected.
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=
# Admin dashboard visitor map (Maps JavaScript API). Not the same as GA4.
# Restrict the key to HTTP referrers and Maps JavaScript API only.
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Email — SMTP (visit fallback + daily digest)
# -----------------------------------------------------------------------------
# Use a Gmail App Password, not the account login password.
# If Firebase push is configured, per-visit alerts go to FCM first; SMTP is the
# fallback and still used for the daily digest when no device token is registered.
NOTIFY_EMAIL=
NOTIFY_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TZ=Asia/Karachi
NOTIFY_DIGEST_HOUR=21
# Set to 1 to run the digest loop in `next dev`. Set to 0 to disable in production.
# NOTIFY_DIGEST_LOOP=

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (admin push)
# -----------------------------------------------------------------------------
# Visits, daily digest, and application-reply notifications.
# Create a Firebase project, add a Web app, generate a Web Push certificate
# (VAPID), and a service account key. Web values are injected after admin
# login — no NEXT_PUBLIC_*.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# -----------------------------------------------------------------------------
# Gmail API (job applications)
# -----------------------------------------------------------------------------
# Enable Gmail API in Google Cloud, create an OAuth client, then store a
# refresh token. Sending needs gmail.send. Inbox sync needs gmail.readonly
# as well (re-consent with both scopes, then replace GMAIL_REFRESH_TOKEN).
# SMTP_USER/SMTP_PASS is used to send if the API is unset. SMTP cannot sync replies.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Push endpoint (Pub/Sub) must include this token:
# https://YOUR_DOMAIN/api/internal/gmail-push?token=...
# Poll backup: POST /api/internal/gmail-sync with Authorization: Bearer ...
# Grant gmail-api-push@system.gserviceaccount.com publisher on the topic.
# Watch expires ~7 days; production renews it on the 15-minute loop.
GMAIL_SYNC_SECRET=
GMAIL_PUBSUB_TOPIC=
# Set to 1 to run the loop in `next dev`. Set to 0 to disable in production.
# GMAIL_SYNC_LOOP=

# -----------------------------------------------------------------------------
# Job search (admin discovery)
# -----------------------------------------------------------------------------
# Public boards need no key: Remote OK, Remotive, Himalayas, Arbeitnow,
# We Work Remotely, Jobicy, Working Nomads, The Muse, HN Who's Hiring, Landing.jobs,
# NoDesk, Get on Board, Jobspresso, The Hub, Agentic Engineering Jobs, a16z Speedrun.
# Optional USAJOBS Search API. Skip both to disable that adapter only.
# https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# Set to 1 to poll listings in `next dev`. Production polls unless this is 0.
# JOB_POLL_LOOP=
